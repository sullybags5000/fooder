# Copy to .env and fill in

# --- Telegram ---
# Create a bot via @BotFather on Telegram, get the token
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL where Telegram will POST updates (e.g. via Cloudflare Tunnel)
# Leave blank to use long polling (dev mode)
TELEGRAM_WEBHOOK_URL=
# Any random string; Telegram will include it in webhook requests
TELEGRAM_WEBHOOK_SECRET=change-me
# Optional: comma-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone. Find your ID by messaging @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# --- Vision LLM ---
# Provider: "gemini" (default, cheap) or "openai"
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Sheets ---
# Path to a Google service account JSON key file
GOOGLE_SHEETS_CREDENTIALS_FILE=./service-account.json
# The spreadsheet's ID (from its URL: docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Worksheet (tab) name. Will be created automatically if it doesn't exist.
GOOGLE_SHEETS_WORKSHEET_NAME=Meals

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
# SQLite path (local cache of pending meal confirmations)
DATABASE_URL=sqlite:///./fooder.db
