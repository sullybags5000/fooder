# Copy to .env and fill in

# --- Telegram ---
# Create a bot via @BotFather on Telegram, get the token
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL where Telegram will POST updates (e.g. via Cloudflare Tunnel)
# Leave blank to use long polling (dev mode)
TELEGRAM_WEBHOOK_URL=
# Any random string; Telegram will include it in webhook requests
TELEGRAM_WEBHOOK_SECRET=change-me

# --- Vision LLM ---
# Provider: "gemini" (default, cheap) or "openai"
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Fitbit ---
# Register app at https://dev.fitbit.com/apps
# OAuth 2.0, app type: Server, scopes: nutrition
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
# Must match the redirect URL in your Fitbit app settings
FITBIT_REDIRECT_URI=http://localhost:8000/fitbit/callback

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
# SQLite path
DATABASE_URL=sqlite:///./fooder.db
